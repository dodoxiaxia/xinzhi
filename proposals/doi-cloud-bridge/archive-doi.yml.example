# REVIEW EXAMPLE ONLY: outside .github/workflows, cannot run or deploy.
# This is a gate/shape example. Upload/download adapters and internal HTTP routes
# must be implemented and accepted before an enabled workflow is installed.
name: doi-archive-single-executor
on:
  workflow_dispatch:
    inputs:
      mode:
        type: choice
        options: [drain, reconcile]
        default: drain
permissions:
  contents: read
  id-token: write
concurrency:
  group: doi-archive-single-executor
  cancel-in-progress: false
  queue: max
jobs:
  archive:
    if: github.ref == 'refs/heads/main' && vars.DOI_ARCHIVE_OWNER_APPROVED == 'true'
    runs-on: ubuntu-latest
    environment: literature-archive
    timeout-minutes: 15
    steps:
      # Approved version must pin checkout/setup actions and verifier dependencies.
      - name: Fail closed while implementation and safe setup are pending
        run: |
          echo '::error::Review example only. No archive transport or owner cutover has been installed.'
          exit 1
      # Final runner requests a short-lived GitHub OIDC token (custom audience),
      # claims the one canonical ledger, and drains persisted submitted tasks.
      # AI_LIBRARY_WRITE_TOKEN and DRIVE_OAUTH_* belong only in approved job env.
      # Never include private source paths, response bodies, PDFs or tokens in logs/artifacts.
