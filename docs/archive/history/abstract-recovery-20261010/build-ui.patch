+def _doi(value):
+    """Canonical DOI identity only; never match papers by title alone."""
+    if not isinstance(value,str):return ''
+    value=value.strip()
+    if re.match(r'^https?://',value,re.I):
+        parsed=urlsplit(value)
+        if (parsed.hostname or '').lower() not in {'doi.org','dx.doi.org'}:return ''
+        value=unquote(parsed.path.lstrip('/'))
+    value=re.sub(r'^doi:\s*','',value,flags=re.I).lower()
+    return value if re.fullmatch(r'10\.\d{4,9}/[^\s\x00-\x1f<>"\\]+',value) else ''
+
+def _pmid(value):
+    value=str(value or '').strip()
+    return value if value.isdigit() else ''
+
+def _abstract_payload(p):
+    sections=p.get('abstractSections') or []
+    sections=[{'label':str(s.get('label') or ''),'text':s['text'].strip()} for s in sections
+              if isinstance(s,dict) and isinstance(s.get('text'),str) and s['text'].strip()] if isinstance(sections,list) else []
+    summary=p.get('summary')
+    summary=summary.strip() if isinstance(summary,str) else ''
+    return {'summary':summary,'abstractSections':sections} if summary or sections else None
+
+def _title_identity(value):
+    return ''.join(c for c in unicodedata.normalize('NFKD',str(value or '')).casefold() if c.isalnum())
+
+def _paper_abstract_source(p):
+    """Require declared official provenance, not the length of an RSS description."""
+    official=p.get('sourceId')=='pubmed-journal-fallback' or p.get('basis')=='PubMed 官方结构化元数据'
+    if official and p.get('summary_truncated') is False and _pmid(p.get('pmid')):
+        return 'PubMed','https://pubmed.ncbi.nlm.nih.gov/'+_pmid(p['pmid'])+'/'
+    source=p.get('abstractSource')
+    if p.get('summary_truncated') is not True and source in {'PubMed','Europe PMC','OpenAlex','Crossref','OpenAlex / Crossref'}:
+        url=safe_url(p.get('abstractSourceUrl',''))
+        if source=='PubMed' and _pmid(p.get('pmid')):url='https://pubmed.ncbi.nlm.nih.gov/'+_pmid(p['pmid'])+'/'
+        return source,url
+    return None
+
+def backfill_public_abstracts(candidates,library,full=None,pdf_abstracts=None):
+    """Fill existing public identities from official text, then verified PDF abstracts.
+
+    Operates on the build's in-memory input lists. It neither adds papers nor changes
+    IDs, titles, dates or guides, and never replaces an existing nonempty abstract.
+    The private PDF receipt and paths are deliberately absent from this projection.
+    """
+    donors=[]
+    def add(p,payload,source,source_url='',require_title=False):
+        if not payload:return
+        doi,pmid=_doi(p.get('doi')),_pmid(p.get('pmid'))
+        if not doi and not pmid:return
+        donors.append({'doi':doi,'pmid':pmid,'title':_title_identity(p.get('title')),
+                       'payload':payload,'source':source,'source_url':safe_url(source_url),
+                       'require_title':require_title})
+    for p in list(candidates)+list(library):
+        payload=_abstract_payload(p);source=_paper_abstract_source(p)
+        if not payload or not source:continue
+        # Explicitly incomplete conclusion-only exports remain on their own card,
+        # but are not spread to another record as the paper's complete abstract.
+        labels=[s['label'].strip().casefold() for s in payload['abstractSections']]
+        if labels and all(re.match(r'^(conclusions?|results?|interpretation|findings|结论|结果)\b',x) for x in labels):continue
+        if not labels and re.match(r'^(conclusions?|结论)\s*:',payload['summary'],re.I):continue
+        add(p,payload,*source)
+    source_names={'pubmed':'PubMed','epmc':'Europe PMC','europepmc':'Europe PMC',
+                  'openalex':'OpenAlex','crossref':'Crossref','openalex/crossref':'OpenAlex / Crossref'}
+    for key,value in (full or {}).items():
+        if not isinstance(value,dict):continue
+        source=source_names.get(str(value.get('src') or '').lower())
+        if not source:continue
+        pmid=_pmid(key)
+        p={'doi':value.get('d'),'pmid':pmid,'abstractSections':[
+            {'label':s.get('l',''),'text':s.get('t','')} for s in value.get('a',[]) if isinstance(s,dict)]}
+        source_url=safe_url(value.get('abstractSourceUrl',''))
+        if source=='PubMed' and pmid:source_url='https://pubmed.ncbi.nlm.nih.gov/'+pmid+'/'
+        add(p,_abstract_payload(p),source,source_url)
+    official_count=len(donors)
+    items=(pdf_abstracts or {}).get('items',{})
+    if isinstance(items,dict):
+        for key,p in items.items():
+            if not isinstance(p,dict):continue
+            doi=_doi(key)
+            if not doi or doi!=_doi(p.get('doi')) or not _title_identity(p.get('title')):continue
+            if p.get('abstractSource')!='论文原摘要（PDF提取）':continue
+            add(p,_abstract_payload(p),p['abstractSource'],p.get('abstractSourceUrl',''),require_title=True)
+    bydoi={};bypmid={}
+    for i,donor in enumerate(donors):
+        if donor['doi']:bydoi.setdefault(donor['doi'],[]).append(i)
+        if donor['pmid']:bypmid.setdefault(donor['pmid'],[]).append(i)
+    report={'candidates':0,'library':0,'pdf':0}
+    for name,papers in [('candidates',candidates),('library',library)]:
+        for p in papers:
+            if _abstract_payload(p):continue
+            doi,pmid=_doi(p.get('doi')),_pmid(p.get('pmid'))
+            matches=sorted(set(bydoi.get(doi,[])+bypmid.get(pmid,[])))
+            for i in matches:
+                donor=donors[i]
+                if doi and donor['doi'] and doi!=donor['doi']:continue
+                if pmid and donor['pmid'] and pmid!=donor['pmid']:continue
+                if donor['require_title'] and (not doi or doi!=donor['doi'] or _title_identity(p.get('title'))!=donor['title']):continue
+                payload=donor['payload']
+                if payload['summary']:p['summary']=payload['summary']
+                if payload['abstractSections']:p['abstractSections']=[dict(s) for s in payload['abstractSections']]
+                p['abstractSource']=donor['source']
+                p['abstractSourceUrl']=donor['source_url']
+                report[name]+=1
+                if i>=official_count:report['pdf']+=1
+                break
+    return report
+
